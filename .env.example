# Токен бота: Discord Developer Portal -> твоё приложение -> Bot -> Reset Token.
# Это пароль от бота: никому не показывай и не публикуй.
DISCORD_TOKEN=

# API-ключ CSFloat: csfloat.com/profile -> вкладка Developer
CSFLOAT_API_KEY=

# Необязательно. ID твоего сервера: тогда команды /auctions и /deals появятся на нём сразу
# (без этого она может появиться не сразу).
GUILD_ID=

# Необязательно. Автоуведомления: ID канала, куда бот будет писать о выгодных аукционах.
# Если пусто, бот только отвечает на команды /auctions и /deals.
ALERT_CHANNEL_ID=
# Как часто проверять CSFloat (минуты)
ALERT_INTERVAL_MIN=5
# Условия для уведомлений: цена до $, закончится в ближайшие N часов, скидка не меньше N %
ALERT_MAX_PRICE=30
ALERT_HOURS=6
ALERT_MIN_DISCOUNT=15
